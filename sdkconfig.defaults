# Shared by both boards. Chip-specific settings live in
# sdkconfig.defaults.esp32p4 and sdkconfig.defaults.esp32s3, which ESP-IDF
# layers on top of this file for the target being built.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi credentials live in our own settings, not the driver's NVS copy.
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# The web server needs 10 sockets of its own on top of Zello, SNTP and DNS.
CONFIG_LWIP_MAX_SOCKETS=16
# About 4 s of outgoing voice, so a Wi-Fi stall doesn't stall the sender.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384

# LVGL. Widgets are allocated in PSRAM (main/lv_mem_psram.c)
# rather than LVGL's small built-in pool, so long channel lists can't exhaust
# internal RAM. The 20/28/36 fonts are the P4's UI sizes; the T-Deck adds 14/16.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_28=y
CONFIG_LV_THEME_DEFAULT_DARK=y

# Long file names for zello-channels.xml.
CONFIG_FATFS_LFN_HEAP=y

# Web config: browsers can send long request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# wss://zello.io: TLS with the bundled root store, and a Zello developer token
# (a JWT) rides in the logon message, so the TX buffer has to hold it.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y

# Crash reports (main/crash_report.c): a panic saves an ELF core dump to the
# coredump partition, and the next boot copies it to the microSD card.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
